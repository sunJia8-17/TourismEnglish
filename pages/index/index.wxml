<view class="page">
  <view class="status-safe" style="height: {{statusBarHeight}}px;"></view>
  <view class="greeting">{{greeting}}，旅行讲解员</view>
  <view class="sub">今天，听一句，写一句。</view>

  <view class="continue" bindtap="onContinue">
    <view class="continue-row">
      <view class="play-mini">
        <view class="tri"></view>
      </view>
      <view class="continue-copy">
        <view class="continue-title">{{continueTitle}}</view>
        <view class="continue-meta en">{{continueMeta}}</view>
      </view>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <view class="section-title">{{scriptCount}} 篇北京导游词</view>

  <view class="grid">
    <view
      class="card"
      wx:for="{{scripts}}"
      wx:key="id"
      bindtap="onOpenScript"
      data-id="{{item.id}}"
    >
      <view class="card-title">{{item.no}} {{item.title}}</view>
      <view class="card-meta">{{item.count}} 句 · {{item.tag}}</view>
    </view>
  </view>
</view>
